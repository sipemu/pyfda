# fdars AI advisor — LLM provider credentials (copy to .env and fill in).
# .env is gitignored; .env.example is the committed template.
#
# Load it before running (zero dependencies, works in zsh/bash):
#   set -a && source .env && set +a
#   .venv/bin/python examples/advisor_recipe.py
#
# Only set the key for the provider you use (default is Anthropic).

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
